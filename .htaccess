Options -Indexes +FollowSymLinks

DirectoryIndex index.php index.html

<FilesMatch "\.(sql|sql\.bak|zip|log|env|ini|sh|bak|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^(?:config|includes)(?:/.*)?$ - [F,L,NC]

    RewriteRule ^pages/?$ / [R=301,L]

    RewriteCond %{REQUEST_URI} ^/(nam1tp|tracker)/ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} !\.(php|html)$ [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} !^/pages/?$ [NC]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/+$
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[?\s] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+pages/logo-detail\.php\?slug=([^&\s]+) [NC]
    RewriteRule ^pages/logo-detail\.php$ /logo/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+pages/([a-zA-Z0-9_-]+)\.php[?\s] [NC]
    RewriteRule ^pages/([a-zA-Z0-9_-]+)\.php$ /$1 [R=301,L]

    RewriteCond %{REQUEST_URI} !^/pages/logo-detail [NC]
    RewriteRule ^pages/([a-zA-Z0-9_-]+)/?$ /$1 [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([a-zA-Z0-9_-]+)\.php[?\s] [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)\.php$ /$1 [R=301,L]

    RewriteRule ^logo/?$ /aset-logo [R=301,L]

    RewriteRule ^logo/(?:pages/)?aset-logo(?:\.php)?$ /aset-logo [R=301,L]

    RewriteRule ^logo/([^/]+)/?$ pages/logo-detail.php?slug=$1 [L,QSA]

    RewriteRule ^profil/?$ pages/profil.php [L,QSA]
    RewriteRule ^aset-logo/?$ pages/aset-logo.php [L,QSA]
    RewriteRule ^layouting/?$ pages/layouting.php [L,QSA]

    RewriteRule ^pages/logo-detail/?$ pages/logo-detail.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ pages/$1.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
    RewriteRule ^pages/([a-zA-Z0-9_-]+)/?$ pages/$1.php [L,QSA]
</IfModule>

AddDefaultCharset UTF-8
